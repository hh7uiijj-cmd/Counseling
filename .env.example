# Copy this file to .env and fill in real values for local development.
# In production (e.g. Railway), set these as environment variables in the
# platform dashboard instead of committing a .env file.

# Supabase: runtime = Transaction pooler (port 6543), add ?sslmode=no-verify
# MIGRATE_DATABASE_URL = Session pooler (port 5432) with ?sslmode=require, used only by `prisma migrate deploy`
# MIGRATE_DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://user:password@localhost:5432/counseling?schema=public"

# Session — generate a long random string, e.g: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string-in-production"

# LINE Messaging API (Official Account) — see README for setup steps
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
LINE_GROUP_ID=""

# LINE Login + LIFF — powers the /me shift sign-up page (see README "หน้าลงเวร").
# The LINE Login channel MUST be in the same provider as the Messaging API channel above.
LINE_LOGIN_CHANNEL_ID=""
LIFF_ID=""

# Public URL of this app (used for links in LINE messages), no trailing slash
APP_BASE_URL="http://localhost:3000"

# Resend (email API) — used to send booking confirmation emails to customers.
# Sign up free at https://resend.com to get an API key. RESEND_FROM_EMAIL is
# optional; only set it once you've verified a custom sending domain there.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Only used by `npm run db:seed` to create the first admin account
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme123"
