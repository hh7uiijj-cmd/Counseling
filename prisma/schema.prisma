// Prisma schema for the counseling room booking system.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum Gender {
  MALE
  FEMALE
  LGBTQ
}

enum YearLevel {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
}

enum Faculty {
  EDUCATION // คณะครุศาสตร์
  SCIENCE_TECHNOLOGY // คณะวิทยาศาสตร์และเทคโนโลยี
  HUMANITIES_SOCIAL_SCIENCES // คณะมนุษยศาสตร์และสังคมศาสตร์
  MANAGEMENT_SCIENCE // คณะวิทยาการจัดการ
  NURSING // คณะพยาบาลศาสตร์
  CULINARY_ARTS // โรงเรียนการเรือน
  TOURISM_HOSPITALITY // โรงเรียนการท่องเที่ยวและการบริการ
  LAW_POLITICS // โรงเรียนกฎหมายและการเมือง
  SUPHANBURI_CAMPUS // วิทยาเขตสุพรรณบุรี
  NAKHONNAYOK_CENTER // ศูนย์การศึกษานครนายก
  LAMPANG_CENTER // ศูนย์การศึกษาลำปาง
  HUAHIN_CENTER // ศูนย์การศึกษาหัวหิน
  TRANG_CENTER // ศูนย์การศึกษาตรัง
}

enum ConsultationTopic {
  STUDY // การเรียน
  LIFE // การใช้ชีวิต
  OTHER // อื่นๆ
}

enum ConsultationFormat {
  ONLINE // On Line: MS Teams
  ONSITE // On Site: ห้อง SDU Counseling Center
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Counselor {
  id         String     @id @default(cuid())
  name       String
  title      String? // e.g. specialty / role, shown to clients
  bio        String?
  photoUrl   String?
  color      String     @default("#2563eb") // used to color-code this counselor on the calendar
  active     Boolean    @default(true)
  lineUserId String? // LINE user ID to @-mention in group notifications for this counselor's bookings
  // Fixed partner for paired shifts (set on both sides of the pair). Slots copy it at creation time.
  partnerId  String?    @unique
  partner    Counselor? @relation("CounselorPair", fields: [partnerId], references: [id], onDelete: SetNull)
  partnerOf  Counselor? @relation("CounselorPair")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  slots        Slot[]        @relation("SlotMain")
  partnerSlots Slot[]        @relation("SlotPartner")
  swapRequests SwapRequest[] @relation("SwapRequester")
  swapTargets  SwapRequest[] @relation("SwapTarget")
}

model ClosedDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@unique([date])
}

model Slot {
  id          String     @id @default(cuid())
  counselorId String? // null = open shift waiting for a pair to claim it
  counselor   Counselor? @relation("SlotMain", fields: [counselorId], references: [id], onDelete: Cascade)
  // Second counselor sitting the same shift (paired shifts). Null for solo slots.
  partnerId   String?
  partner     Counselor? @relation("SlotPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  date        DateTime   @db.Date
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime   @default(now())

  booking Booking?

  swapsFrom SwapRequest[] @relation("SwapFrom")
  swapsTo   SwapRequest[] @relation("SwapTo")

  @@index([date])
  @@index([counselorId, date])
  @@index([partnerId, date])
}

model Booking {
  id                 String             @id @default(cuid())
  slotId             String             @unique
  slot               Slot               @relation(fields: [slotId], references: [id], onDelete: Cascade)
  clientName         String // ชื่อ-นามสกุล
  studentId          String? // เลขระเบียน
  gender             Gender // เพศ
  yearLevel          YearLevel // ชั้นปี
  faculty            Faculty // คณะ/โรงเรียน/วิทยาเขต/ศูนย์การศึกษา
  major              String // หลักสูตร/สาขาวิชา
  topicCategory      ConsultationTopic // เรื่องที่ขอรับคำปรึกษา
  topicOther         String? // รายละเอียดเพิ่มเติมเมื่อเลือก "อื่นๆ"
  consultationFormat ConsultationFormat // รูปแบบการให้คำปรึกษา
  clientPhone        String // เบอร์โทรศัพท์มือถือ
  clientEmail        String // E-mail Address
  lineId             String // ID Line
  note               String?
  status             BookingStatus      @default(PENDING)
  lineNotified       Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum SwapStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Simple key/value store for admin-tunable settings (e.g. shift limits).
model Setting {
  key   String @id
  value String
}

/// A pair asks another pair to trade one of their shifts for one of ours.
model SwapRequest {
  id            String     @id @default(cuid())
  fromSlotId    String
  fromSlot      Slot       @relation("SwapFrom", fields: [fromSlotId], references: [id], onDelete: Cascade)
  toSlotId      String
  toSlot        Slot       @relation("SwapTo", fields: [toSlotId], references: [id], onDelete: Cascade)
  requestedById String
  targetId      String
  target        Counselor  @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)
  requestedBy   Counselor  @relation("SwapRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  status        SwapStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  resolvedAt    DateTime?

  @@index([fromSlotId])
  @@index([toSlotId])
  @@index([targetId])
}
